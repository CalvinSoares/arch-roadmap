# URL pública do DevMappa — sem barra no final.
NEXT_PUBLIC_SITE_URL=https://arch-roadmap.vercel.app

# ─────────────────────────────────────────────────────────────────────────
# Plataforma (Fase 0) — preencha ao provisionar. Isto é só TEMPLATE; os
# valores reais vão no .env.local (git-ignored), nunca aqui.
# ─────────────────────────────────────────────────────────────────────────

# Neon Postgres — use o endpoint POOLED na aplicação; o DIRETO só nas migrações.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require

# Auth.js (NextAuth v5)
AUTH_SECRET=              # gere com: openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# E-mail — magic link + reset de senha (Resend)
RESEND_API_KEY=
EMAIL_FROM=DevMappa <no-reply@seu-dominio>

# Rate limit — Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron (Vercel) — protege /api/cron da virada semanal de temporada.
# Gere um valor forte: openssl rand -base64 32
CRON_SECRET=
